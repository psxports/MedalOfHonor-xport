{
  "schema": 1,
  "name": "Medal Of Honor",
  "short_name": "MOH",
  "toolset": "C:\\Projects\\xports\\xport\\tools",
  "paths": {
    "status": "status",
    "project_tools": "tools",
    "analysis_database": "status/analysis.sqlite",
    "native_executable": "bin/MOH.exe",
    "native_debug_executable": "bin/MOH_debug.exe",
    "native_working_directory": "bin",
    "native_solution": "src/platform/win/MOH.sln",
    "native_build": "_build",
    "ida_exports": "orig/images",
    "ida_configs": "tools/ida",
    "sdk_classification": "status/ghidra/classification.json",
    "disc_image": "iso/Medal of Honor (USA).cue",
    "music_source": "iso",
    "music_output": "bin/MUSIC",
    "original_executable": "orig/SLUS_009.74"
  },
  "duckstation": {
    "host": "127.0.0.1",
    "gdb_port": 2432,
    "reserved_gdb_ports": {
      "user": 2432,
      "lockstep": 2433
    },
    "default_role": "user",
    "data_directory": "tools/duckstation/data/user",
    "data_directories": {
      "user": "tools/duckstation/data/user",
      "lockstep": "tools/duckstation/data/lockstep"
    }
  },
  "lockstep": {
    "schema": 1,
    "enabled": true,
    "original_image": "SLUS_009.74",
    "native_configuration": "Debug",
    "native_platform": "x86",
    "msbuild_property": "LockstepDebug=true",
    "source_roots": [
      "src"
    ],
    "max_events": 1000000,
    "memory": {
      "dram_size": 2097152,
      "scratchpad_size": 1024
    },
    "devices": {
      "vram": "trusted_wrapper",
      "spu_ram": "trusted_wrapper"
    },
    "runtime": {
      "duckstation_role": "lockstep",
      "record_role": "user",
      "native_arguments": [
        "--lockstep-replay"
      ]
    }
  },
  "code_refresh": {
    "build": {
      "solution": "src/platform/win/MOH.sln",
      "configuration": "Debug",
      "platform": "x86",
      "process_name": "MOH_debug.exe"
    },
    "tests": [],
    "artifacts": []
  },
  "analysis": {
    "images": [
      "SLUS_009.74"
    ],
    "default_image": "SLUS_009.74",
    "pseudocode_reviews": "status/function-coverage/first/pseudocode-reviews.json"
  },
  "capabilities": {
    "redbook_audio": {
      "enabled": false,
      "reason": "Reviewed CUE contains no AUDIO tracks"
    }
  },
  "coverage_permissions": {
    "allow_missing_bios_stubs": true,
    "allow_missing_sdk_stubs": true
  }
}
